{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.diyaluo/image-toolkit-mcp",
  "description": "Local batch image processing MCP server: resize, convert, compress, watermark, strip EXIF. Fully offline, no API key.",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/diyaluo/image-toolkit-mcp:v0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "docker",
      "runtimeArguments": [
        { "type": "positional", "value": "run" },
        { "type": "positional", "value": "-i" },
        { "type": "positional", "value": "--rm" },
        { "type": "positional", "value": "ghcr.io/diyaluo/image-toolkit-mcp:v0.1.0" }
      ]
    }
  ],
  "tools": [
    { "name": "image_resize" },
    { "name": "image_convert" },
    { "name": "image_compress" },
    { "name": "image_watermark" },
    { "name": "image_strip" },
    { "name": "image_selftest" }
  ]
}
